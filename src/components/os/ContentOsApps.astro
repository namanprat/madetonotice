---
/**
 * Styles for the window bodies drawn by `src/os/apps/*`.
 *
 * Those are plain TypeScript modules with no markup of their own, so their CSS
 * lives here rather than being scattered into the page.
 */
---

<style is:global>
  @layer components {
    /* ── Folder / My Computer ──────────────────────────────────────────── */

    .folder_drive {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.375rem;
    }

    .folder_drive_label {
      font-size: var(--os-type-ui);
    }

    .folder_drive_box {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      flex: 1;
      min-width: 0;
      height: 1.5rem;
      padding-left: 0.375rem;
      background-color: var(--os-highlight);
      border: var(--os-hair) solid #151515;
      border-right-color: var(--os-highlight);
      border-bottom-color: var(--os-highlight);
      outline: var(--os-hair) solid #797676;
      font-size: var(--os-type-ui);
    }

    .folder_drive_box img {
      width: 0.875rem;
      height: 0.875rem;
    }

    .folder_drive_box span {
      flex: 1;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .folder_drive_btn {
      display: grid;
      place-items: center;
      width: 1.125rem;
      height: 1.25rem;
      margin-right: 0.0625rem;
      background-color: var(--os-face);
      border: 0.125rem solid #000000;
      border-top-color: #f6f4f4;
      border-left-color: #f6f4f4;
      cursor: default;
    }

    .folder_drive_btn:active {
      border-color: #f6f4f4;
      border-top-color: #000000;
      border-left-color: #000000;
    }

    .folder_caret {
      width: 0;
      height: 0;
      border: 0.1875rem solid transparent;
    }

    .folder_caret.down {
      border-top-color: #000000;
      border-bottom-width: 0;
    }

    .folder_view {
      padding: 0.25rem;
    }

    .folder_list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .folder_item {
      display: grid;
      place-items: center;
      align-content: start;
      gap: 0.25rem;
      width: 5rem;
      padding: 0.375rem 0.25rem;
      background-color: transparent;
      border: var(--os-hair) dotted transparent;
      font-family: inherit;
      font-size: var(--os-type);
      color: inherit;
      text-align: center;
      cursor: default;
    }

    .folder_item_img {
      width: 2rem;
      height: 2rem;
    }

    .folder_item_label {
      max-width: 100%;
      line-height: 1.1;
      overflow-wrap: anywhere;
    }

    .folder_item:focus-visible {
      border-color: currentColor;
    }

    @media (hover: hover) {
      .folder_item:hover .folder_item_label {
        background-color: var(--os-select-icon);
        color: var(--os-title-text);
      }
    }

    .folder_empty {
      margin: 0;
      padding: 0.75rem;
      font-size: var(--os-type);
    }

    /* ── About ─────────────────────────────────────────────────────────── */

    .app_about {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      padding: 0.75rem;
    }

    .app_about_authors {
      margin: 0;
      font-size: var(--os-type-ui);
    }

    .app_tabs {
      display: flex;
      gap: 0.125rem;
    }

    .app_tab {
      padding: 0.25rem 0.5rem;
      background-color: var(--os-face);
      border: 0.125rem solid #000000;
      border-top-color: #f0efef;
      border-left-color: #f0efef;
      border-right-color: #353434;
      font-family: inherit;
      font-size: var(--os-type-ui);
      color: inherit;
      cursor: default;
    }

    .app_tab.is-active {
      position: relative;
      bottom: 0.125rem;
      background-color: var(--os-highlight);
      outline: var(--os-hair) dotted #000000;
      outline-offset: -0.25rem;
    }

    .app_tabpanel {
      font-size: var(--os-type);
      line-height: 1.5;
    }

    /* ── Mail ──────────────────────────────────────────────────────────── */

    .app_mail {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      height: 100%;
      padding: 0.75rem;
    }

    .app_mail_to {
      display: flex;
      gap: 0.25rem;
    }

    .app_mail_to_label {
      flex-shrink: 0;
      min-width: 3rem;
    }

    .app_mail_to .os_input {
      flex: 1;
      min-width: 0;
      background-color: #ececec;
      color: var(--os-shadow-soft);
    }

    .app_mail_field {
      display: flex;
      flex-direction: column;
      gap: 0.1875rem;
      font-size: var(--os-type);
    }

    .app_mail_body {
      flex: 1;
      min-height: 6rem;
    }

    .app_mail_body textarea {
      flex: 1;
      min-height: 5rem;
      resize: none;
    }

    .app_mail_actions {
      display: flex;
      justify-content: flex-end;
    }

    /* ── Internet Explorer ─────────────────────────────────────────────── */

    .app_ie {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .ie_toolbar {
      display: flex;
      gap: 0.125rem;
      flex-shrink: 0;
      padding: 0.25rem;
      background-color: var(--os-face);
      border-bottom: var(--os-hair) solid var(--os-shadow-soft);
    }

    .ie_btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.0625rem;
      padding: 0.1875rem 0.375rem;
      background-color: transparent;
      border: var(--os-hair) solid transparent;
      font-family: inherit;
      font-size: var(--os-type-tiny);
      color: inherit;
      cursor: default;
    }

    .ie_btn img {
      width: 1.25rem;
      height: 1.25rem;
    }

    .ie_btn:active {
      border-color: #000000;
      border-bottom-color: var(--os-highlight);
      border-right-color: var(--os-highlight);
    }

    @media (hover: hover) {
      .ie_btn:hover {
        border-color: var(--os-highlight);
        border-bottom-color: #000000;
        border-right-color: #000000;
      }
    }

    .ie_address_row {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      flex-shrink: 0;
      padding: 0.25rem;
      background-color: var(--os-face);
    }

    .ie_address_label {
      font-size: var(--os-type-ui);
    }

    .ie_address_box {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      flex: 1;
      min-width: 0;
      padding-left: 0.25rem;
      background-color: var(--os-highlight);
      border: var(--os-hair) solid #151515;
      border-right-color: var(--os-highlight);
      border-bottom-color: var(--os-highlight);
      outline: var(--os-hair) solid #797676;
    }

    .ie_address_box img {
      width: 0.875rem;
      height: 0.875rem;
      flex-shrink: 0;
    }

    .ie_address {
      flex: 1;
      min-width: 0;
      padding: 0.25rem 0.25rem 0.25rem 0;
      background-color: transparent;
      border: 0;
      outline: 0;
      font-family: inherit;
      font-size: var(--os-type);
      color: var(--os-shadow);
    }

    .ie_frame_wrap {
      position: relative;
      flex: 1;
      min-height: 0;
      background-color: var(--os-highlight);
    }

    .ie_frame {
      width: 100%;
      height: 100%;
      border: 0;
      background-color: var(--os-highlight);
      image-rendering: auto;
    }

    .ie_fallback {
      position: absolute;
      inset: 0;
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 0.625rem;
      padding: 1rem;
      background-color: var(--os-face);
      text-align: center;
    }

    .ie_fallback img {
      width: 2rem;
      height: 2rem;
    }

    .ie_fallback p {
      margin: 0;
      font-size: var(--os-type);
    }

    /* ── Paint / embedded frames ───────────────────────────────────────── */

    .app_iframe_wrap {
      width: 100%;
      height: 100%;
      background-color: var(--os-highlight);
    }

    .app_iframe {
      width: 100%;
      height: 100%;
      border: 0;
      image-rendering: auto;
    }

    /* ── Notepad ───────────────────────────────────────────────────────── */

    .app_notepad {
      display: block;
      width: 100%;
      height: 100%;
      padding: 0.25rem 0.375rem;
      background-color: var(--os-highlight);
      border: 0;
      outline: 0;
      resize: none;
      font-family: inherit;
      font-size: var(--os-type-ui);
      line-height: 1.4;
      color: var(--os-shadow);
      white-space: pre;
      overflow: auto;
    }

    .app_notepad.is-wrapped {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    /* ── Settings ──────────────────────────────────────────────────────── */

    .app_settings {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.75rem;
    }

    .settings_label {
      margin: 0.25rem 0 0;
      font-size: var(--os-type-ui);
      font-weight: 700;
    }

    .settings_row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .settings_swatch {
      width: 2rem;
      height: 1.5rem;
      padding: 0;
      background-color: var(--swatch);
      border: 0.125rem solid var(--os-highlight);
      border-bottom-color: #000000;
      border-right-color: #000000;
      cursor: default;
    }

    .settings_swatch.is-active {
      outline: var(--os-hair) dotted var(--os-shadow);
      outline-offset: 0.125rem;
    }

    /* ── Minesweeper ───────────────────────────────────────────────────── */

    .app_mine {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      align-items: center;
      min-height: 100%;
      padding: 0.5rem;
      background-color: var(--os-face);
    }

    .mine_hud {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      width: 100%;
      padding: 0.25rem 0.375rem;
      border: var(--os-hair) solid #808080;
      border-right-color: var(--os-highlight);
      border-bottom-color: var(--os-highlight);
    }

    .mine_leds {
      position: relative;
      padding: 0 0.1875rem;
      background-color: #000000;
      font-family: var(--os-font-led);
      font-size: 1.5rem;
      line-height: 1.1;
      color: #ff0000;
      letter-spacing: 0.05em;
    }

    /* Unlit segments behind the live digits, as a real LED display shows. */
    .mine_leds::before {
      content: "888";
      position: absolute;
      inset: 0;
      padding: inherit;
      color: rgb(255 0 0 / 0.25);
    }

    .mine_face {
      display: grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      padding: 0;
      background-color: var(--os-face);
      border: 0.125rem solid var(--os-highlight);
      border-bottom-color: #808080;
      border-right-color: #808080;
      cursor: default;
    }

    .mine_face:active {
      border-color: #808080;
      border-bottom-color: var(--os-highlight);
      border-right-color: var(--os-highlight);
    }

    .mine_face img {
      width: 1.25rem;
      height: 1.25rem;
    }

    .mine_grid {
      display: grid;
      grid-template-columns: repeat(var(--mine-cols), 1.125rem);
      grid-auto-rows: 1.125rem;
      border: var(--os-hair) solid #808080;
      border-right-color: var(--os-highlight);
      border-bottom-color: var(--os-highlight);
    }

    .mine_cell {
      display: grid;
      place-items: center;
      padding: 0;
      background-color: var(--os-face);
      border: 0.125rem solid var(--os-highlight);
      border-bottom-color: #808080;
      border-right-color: #808080;
      font-family: inherit;
      font-size: var(--os-type-ui);
      font-weight: 700;
      line-height: 1;
      cursor: default;
    }

    .mine_cell img {
      width: 0.75rem;
      height: 0.75rem;
    }

    .mine_cell.is-revealed {
      background-color: var(--os-face);
      border: var(--os-hair) solid #9a9a9a;
    }

    .mine_cell.is-mine {
      background-color: #ff0000;
    }

    .mine_dot {
      width: 0.5rem;
      height: 0.5rem;
      background-color: #000000;
      border-radius: 50%;
    }

    /* Canonical Minesweeper number colours. */
    .mine_cell.n1 { color: #0000ff; }
    .mine_cell.n2 { color: #008000; }
    .mine_cell.n3 { color: #ff0000; }
    .mine_cell.n4 { color: #000080; }
    .mine_cell.n5 { color: #800000; }
    .mine_cell.n6 { color: #008080; }
    .mine_cell.n7 { color: #000000; }
    .mine_cell.n8 { color: #808080; }

    /* ── Mobile ────────────────────────────────────────────────────────── */

    @media (width < 30rem) {
      .folder_item {
        width: 4.25rem;
      }

      .ie_btn span {
        display: none;
      }

      .ie_address_label {
        display: none;
      }

      .mine_grid {
        grid-template-columns: repeat(var(--mine-cols), 1.5rem);
        grid-auto-rows: 1.5rem;
      }
    }
  }
</style>
